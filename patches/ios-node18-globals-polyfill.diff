+// iOS: this embedded nodejs-mobile runtime is Node 18.20.4, which has
+// no global `File` (added as a default global only in Node 20 -- Node
+// 18 exposes it only as a named export of node:buffer, since 18.13.0).
+// vscode's bundled `undici` dependency (loaded transitively by the
+// extension host's own HTTP client wiring, e.g. @vscode/proxy-agent)
+// references the global `File` unconditionally at module-load time
+// (node_modules/undici/lib/web/webidl/index.js), crashing this whole
+// Worker with "ReferenceError: File is not defined" before it can even
+// finish loading -- confirmed via a real captured node-stdio.log
+// ("Extension Host Worker had an error" / "exited with code: 1" on
+// every single connection attempt), not guessed. Harmless everywhere
+// else (only applies when the global is actually missing).
+if (typeof (globalThis as any).File === 'undefined') {
+	(globalThis as any).File = (await import('node:buffer')).File;
+}
+
+// iOS: same embedded-Node-18.20.4 gap as the `File` polyfill just above,
+// this time for the global `crypto` (Web Crypto API) -- unflagged as a
+// default global only since Node 19; Node 18 exposes the same interface
+// (confirmed against Node's own v18.20.4 source,
+// lib/internal/crypto/webcrypto.js, which has both randomUUID and
+// getRandomValues) only via node:crypto's named `webcrypto` export.
+// vscode's own vs/base/common/uuid.ts references the bare `crypto`
+// global unconditionally in generateUuid's module-load-time IIFE
+// (`typeof crypto.randomUUID === 'function'`), and that module is
+// pulled in early enough in the extension host's own bootstrap chain
+// that it crashed the Worker with "ReferenceError: crypto is not
+// defined" the moment the File bug above stopped masking it --
+// confirmed via a real captured node-stdio.log
+// (vs/workbench/api/node/extensionHostProcess.js in the stack trace),
+// not guessed. Harmless everywhere else (only applies when the global
+// is actually missing).
+if (typeof (globalThis as any).crypto === 'undefined') {
+	(globalThis as any).crypto = (await import('node:crypto')).webcrypto;
+}
+
 // Bootstrap ESM
 await bootstrapESM();
 
